<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <Version>0.1.0-alpha.4</Version>
    <RepositoryUrl>https://github.com/GNh0/SAPi</RepositoryUrl>
    <PackageProjectUrl>https://github.com/GNh0/SAPi</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup><None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
