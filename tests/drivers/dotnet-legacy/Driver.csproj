    <ProjectReference Include="../../../sdks/dotnet/SApi.Protocol/SApi.Protocol.csproj" />
    <ProjectReference Include="../../../sdks/dotnet/SApi.AspNet/SApi.AspNet.csproj" />
  </ItemGroup>
</Project>
